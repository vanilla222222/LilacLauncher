diff --git a/crates/cordial-runtime/src/android/asset.rs b/crates/cordial-runtime/src/android/asset.rs
--- a/crates/cordial-runtime/src/android/asset.rs
+++ b/crates/cordial-runtime/src/android/asset.rs
@@ -420,8 +420,17 @@
 /// This mirrors the rule [`crate::flags::resolve`] already uses, for the
 /// reason recorded there — an explicit choice the user made must not be
 /// silently overridden by something they installed to do something else.
 fn layers() -> Vec<OverlayLayer> {
     let mut layers = PLUGIN_OVERLAYS.lock().map(|s| s.clone()).unwrap_or_default();
+    // LilacRuntime generates this layer from the imported build before the
+    // shell starts. It stays below the user's root, so an explicit overlay
+    // still wins, and no Roblox archive or extracted asset is written.
+    if let Some(root) = std::env::var_os("LILAC_HOME_OVERLAY").map(PathBuf::from) {
+        layers.push(OverlayLayer {
+            source: OverlaySource::Plugin("lilac-home-theme".into()),
+            root,
+        });
+    }
     layers.push(OverlayLayer { source: OverlaySource::User, root: user_root() });
     layers
 }

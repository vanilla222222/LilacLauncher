new file mode 100644
index 0000000..8dd5560
--- /dev/null
+++ b/crates/cordial-shell/src/lilac_theme.rs
@@ -0,0 +1,30 @@
+//! The fork's GTK chrome palette, separate from the Roblox-rendered surface.
+
+use libadwaita as adw;
+use adw::gtk;
+use std::cell::Cell;
+
+thread_local! {
+    static INSTALLED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Install once per GTK thread so settings and transient dialogs inherit the
+/// same palette without restyling the engine's rendered content.
+pub fn install() {
+    let Some(display) = gtk::gdk::Display::default() else { return };
+    if INSTALLED.with(|installed| installed.replace(true)) {
+        return;
+    }
+    // The comparison switch affects chrome only and is read once at startup.
+    let icons = gtk::IconTheme::for_display(&display);
+    icons.add_search_path(concat!(env!("CARGO_MANIFEST_DIR"), "/../../packaging/icons"));
+    if matches!(std::env::var("LILAC_THEME").as_deref(), Ok("off")) {
+        return;
+    }
+    adw::StyleManager::default().set_color_scheme(adw::ColorScheme::ForceDark);
+    let provider = gtk::CssProvider::new();
+    provider.load_from_string(include_str!("lilac.css"));
+    gtk::style_context_add_provider_for_display(
+        &display, &provider, gtk::STYLE_PROVIDER_PRIORITY_APPLICATION + 1,
+    );
+}
